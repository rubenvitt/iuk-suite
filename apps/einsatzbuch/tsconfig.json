{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@kern/*": ["../../src/app/m/einsatzbuch/_lib/kern/*"],
      "@/core/theme/tokens": ["../../src/core/theme/tokens.ts"],
      "@/core/ikonen/Icons8Ikone": ["../../src/core/ikonen/Icons8Ikone.tsx"]
    }
  },
  "include": ["src", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
