      {
        "selector": "JSXOpeningElement[name.name='Gefahrenzone'] > JSXAttribute > JSXIdentifier[name!=/^(?:titel|children|style|key|ref|className|style|children)$/]",
        "message": "<Gefahrenzone> doesn't accept that prop. Declared props: titel, children, style."
