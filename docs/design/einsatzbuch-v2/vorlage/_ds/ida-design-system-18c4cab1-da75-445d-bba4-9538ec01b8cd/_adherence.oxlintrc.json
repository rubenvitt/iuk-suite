      {
        "selector": "JSXOpeningElement[name.name='KioskFeld'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|value|onChange|placeholder|style|key|ref|className|style|children)$/]",
        "message": "<KioskFeld> doesn't accept that prop. Declared props: variant, value, onChange, placeholder, style."
