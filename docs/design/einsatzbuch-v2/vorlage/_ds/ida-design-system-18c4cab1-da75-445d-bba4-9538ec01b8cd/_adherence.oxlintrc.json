{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/kiosk/bedienung/**",
              "components/kiosk/flaechen/**",
              "components/verwaltung/daten/**",
              "components/verwaltung/forms/**",
              "components/verwaltung/hinweise/**",
              "components/verwaltung/shell/**",
              "ui_kits/feedback/**",
              "ui_kits/kiosk/**",
              "ui_kits/radio/**",
              "ui_kits/uav/**",
              "ui_kits/verwaltung/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow|Barlow Condensed|Geist|Geist Mono|IBM Plex Mono|Newsreader))/i]",
        "message": "Font not provided by the design system. Available: Barlow, Barlow Condensed, Geist, Geist Mono, IBM Plex Mono, Newsreader."
      },
      {
        "selector": "JSXOpeningElement[name.name='Abschlussleiste'] > JSXAttribute > JSXIdentifier[name!=/^(?:titel|text|aktion|onAktion|disabled|ruhend|pfeil|key|ref|className|style|children)$/]",
        "message": "<Abschlussleiste> doesn't accept that prop. Declared props: titel, text, aktion, onAktion, disabled, ruhend, pfeil."
      },
      {
        "selector": "JSXOpeningElement[name.name='LauncherEintrag'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|title|beschreibung|abschnitt|icon|href|key|ref|className|style|children)$/]",
        "message": "<LauncherEintrag> doesn't accept that prop. Declared props: key, title, beschreibung, abschnitt, icon, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|density|block|icon|shape|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, density, block, icon, shape, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|default|danger|text|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'default' | 'danger' | 'text' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='density'] > Literal[value!=/^(?:arbeit|einsatz|schreibtisch)$/]",
        "message": "<Button> density must be one of 'arbeit' | 'einsatz' | 'schreibtisch'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:default|circle)$/]",
        "message": "<Button> shape must be one of 'default' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|extra|size|hoverable|bodyPadding|children|style|bodyStyle|onClick|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, extra, size, hoverable, bodyPadding, children, style, bodyStyle, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|small)$/]",
        "message": "<Card> size must be one of 'default' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:ton|zeichen|block|title|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: ton, zeichen, block, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spalte'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|title|align|width|lesebreite|render|key|ref|className|style|children)$/]",
        "message": "<Spalte> doesn't accept that prop. Declared props: key, title, align, width, lesebreite, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spalte'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<Spalte> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fach'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|style|key|ref|className|style|children)$/]",
        "message": "<Fach> doesn't accept that prop. Declared props: children, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fach'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:kiosk|verwaltung)$/]",
        "message": "<Fach> variant must be one of 'kiosk' | 'verwaltung'."
