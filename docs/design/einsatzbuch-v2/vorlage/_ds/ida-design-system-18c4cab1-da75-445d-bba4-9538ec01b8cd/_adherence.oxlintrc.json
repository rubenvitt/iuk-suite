        "message": "<JournalDelta> doesn't accept that prop. Declared props: wert, einheit."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kachel'] > JSXAttribute > JSXIdentifier[name!=/^(?:zahl|beschriftung|ton|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Kachel> doesn't accept that prop. Declared props: zahl, beschriftung, ton, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kachel'] > JSXAttribute[name.name='ton'] > Literal[value!=/^(?:ok|gelb|rot|grau)$/]",
        "message": "<Kachel> ton must be one of 'ok' | 'gelb' | 'rot' | 'grau'."
